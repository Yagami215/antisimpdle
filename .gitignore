# ==============================================================================
# Antisimpdle .gitignore
# Excludes local editor, local development server, and sensitive/temp files
# ==============================================================================

# Local Editor Files (KEEP LOCAL - DO NOT UPLOAD TO WEBSITE)
editor.html
editor.js
editor.css
server.py
start-editor.bat
init_categories.py
members.txt

# Case Opening Raw Unencrypted Media (Keep private locally - only case opening/vault/ is uploaded)
case opening/common/
case opening/uncommon/
case opening/rare/
case opening/epic/
case opening/legendary/
case opening/mythic/
case opening/divine/
case opening/HELL/

# Python cache & virtual environments
__pycache__/
*.py[cod]
*$py.class
.venv/
env/
venv/
ENV/

# IDE & Editor system files
.vscode/
.idea/
*.swp
*.swo
*~
*.bak

# Operating System temporary files
Thumbs.db
Desktop.ini
.DS_Store
