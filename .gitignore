# ==============================================================================
# Antisimpdle .gitignore
# Excludes local editor, local development server, and sensitive/temp files
# ==============================================================================

# Local Editor & Build Scripts (KEEP LOCAL - DO NOT UPLOAD TO WEBSITE)
editor.html
editor.js
editor.css
server.py
start-editor.bat
init_categories.py
members.txt
parse_cases.py
parse_pictures.py
parse_quotes.py
kvotes.txt
vault.wat

# Case Opening Secret Encrypted Media (Keep raw files private - only decrypted via serverless API / WASM)
case opening/divine/
case opening/HELL/
case opening/verity/
case opening/rainbow/
case opening/milestones/

# Python cache & virtual environments
__pycache__/
*.py[cod]
*$py.class
.venv/
env/
venv/
ENV/

# IDE & Editor system files
.vscode/
.idea/
*.swp
*.swo
*~
*.bak

# Operating System temporary files
Thumbs.db
Desktop.ini
.DS_Store
